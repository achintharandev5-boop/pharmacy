NEXT_PUBLIC_API_URL=http://localhost:3001
# Set to true only for the frontend-only Vercel deployment. Backend operations stay unavailable.
FRONTEND_ONLY_MODE=false
# Production also requires PILOT_API_URL to match the configured HTTPS API target.
# API_URL is the preferred server-only override; development may leave both unset.
API_URL=
PILOT_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Text.lk SMS Gateway Configuration
SMS_ENABLED=false
# Production sends are blocked regardless of this legacy development switch.
TEXT_LK_API_TOKEN=your_text_lk_api_token_here
TEXT_LK_SENDER_ID=TextLKDemo

# Label wording. Leave unset to print today's approved wording. Set to "spec" only after the
# pharmacist approves docs/PHARMACIST_APPROVAL_REQUIRED.md (handwritten-spec wording and rules).
# NEXT_PUBLIC_LABEL_WORDING=spec

# Database-free UI testing. Development only; production builds reject true. To use it locally,
# put NEXT_PUBLIC_UI_TEST_MODE=true in .env.development.local (read by `next dev`, never by
# `next build`) and sign in as tester@pharmacy.local / Test@12345.
# (The older UI_DEMO_MODE / UI_DEMO_EMAIL / UI_DEMO_PASSWORD settings were retired and do nothing.)
NEXT_PUBLIC_UI_TEST_MODE=false
# Optional server-only overrides: UI_TEST_EMAIL, UI_TEST_PASSWORD

# Pharmacy details printed in the label footer, exactly as written. Leave one empty to omit it from
# the label (nothing is printed in its place). Restart the dev server / rebuild after changing.
NEXT_PUBLIC_PHARMACY_NAME=
NEXT_PUBLIC_PHARMACY_ADDRESS=
NEXT_PUBLIC_PHARMACY_PHONE=
