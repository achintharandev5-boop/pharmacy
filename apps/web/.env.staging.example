# TEMPLATE ONLY — use the hosting provider's Staging environment scope or an ignored local file.
# Next.js does not automatically load arbitrary .env.staging files in every command mode;
# inject these values explicitly using the approved deployment platform/environment loader.
API_URL=https://<staging-api-origin>
PILOT_API_URL=https://<staging-api-origin>
SMS_ENABLED=false
# Database-backed staging verification must use real approved staging sessions.
NEXT_PUBLIC_UI_TEST_MODE=false
# Do not add SUPABASE_SERVICE_ROLE_KEY or any other server secret to the web environment.
# SMS is always disabled in synthetic staging. Do not configure provider credentials.
# TEXT_LK_API_TOKEN=<staging-sms-token-from-secret-manager>
# TEXT_LK_SENDER_ID=<approved-staging-sender-id>

# Pharmacy details printed in the label footer, exactly as written. Leave one empty to omit it from
# the label (nothing is printed in its place). Restart the dev server / rebuild after changing.
NEXT_PUBLIC_PHARMACY_NAME=<pharmacy name>
NEXT_PUBLIC_PHARMACY_ADDRESS=<address>
NEXT_PUBLIC_PHARMACY_PHONE=<phone line as printed>

DEPLOYMENT_PROFILE=synthetic-staging
NEXT_PUBLIC_DEPLOYMENT_PROFILE=synthetic-staging
STAGING_DATA_POLICY=synthetic-only
STAGING_GATEWAY_TOKEN=<same-private-32-byte-hex-token-as-staging-api>
ENABLE_EXPERIMENTAL_COREPACK=1
