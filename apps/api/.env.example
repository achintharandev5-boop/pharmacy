# API configuration. Copy to .env and fill in. Never commit .env.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase secret (service-role) key. Server-side only: it bypasses Row Level Security.
# Never expose it to the web app or the browser.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001

# Comma-separated list of origins allowed to call the API.
FRONTEND_URL=http://localhost:3000

# IANA time zone used for 'today' on the dashboard and for expiry checks.
PHARMACY_TIMEZONE=Asia/Colombo

# How prescriptions are saved: legacy (default) or transactional.
# transactional uses the create_prescription database function (batch-level, earliest
# expiry first). Do NOT set it until the pharmacist has approved the allocation rules and
# migration 20261010000500 is applied. See docs/STAGING_READINESS_REPORT.md.
PRESCRIPTION_WRITE_MODE=legacy

# Required for production. Assign the same pharmacy UUID in approved users' app_metadata.
# This database and deployment must belong to exactly one pharmacy.
PILOT_PHARMACY_ID=
PILOT_SUPABASE_URL=
