# TEMPLATE ONLY — do not commit populated copies.
# Set actual values only in the staging API host's secret manager or ignored local file.
# Replace the project-ref placeholder and verify it against the owner-approved staging project.
SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-secret-from-secret-manager>
PORT=3001
FRONTEND_URL=https://<staging-web-origin>
PHARMACY_TIMEZONE=Asia/Colombo
# Feature #21: pharmacy scope is trusted Supabase Auth app_metadata.pharmacy_id (UUID).
# An authorized operator must provision approved staging accounts; there is no client/env override.
# Apply the reviewed Reasons migration only after project/backup verification and explicit approval.
# Keep legacy until stock reconciliation and pharmacist approval permit a staging-only trial.
PRESCRIPTION_WRITE_MODE=legacy
# Required when running the staging release with NODE_ENV=production.
PILOT_PHARMACY_ID=<owner-approved-pharmacy-uuid>
PILOT_SUPABASE_URL=https://<staging-project-ref>.supabase.co

DEPLOYMENT_PROFILE=synthetic-staging
STAGING_DATA_POLICY=synthetic-only
STAGING_SUPABASE_URL=https://<staging-project-ref>.supabase.co
STAGING_GATEWAY_TOKEN=<private-32-byte-hex-token-generated-in-secret-manager>
SMS_ENABLED=false
